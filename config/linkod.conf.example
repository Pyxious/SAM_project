# ==============================================================================
# LINKod Sysadmin Toolkit Configuration File
# Location on server: /etc/linkod/linkod.conf
# Required Permissions: 600 (root:root) -> sudo chmod 600 /etc/linkod/linkod.conf
# ==============================================================================

APP_NAME="LINKod"
APP_DIR="/var/www/linkod"
APP_URL="http://localhost"
APP_PORT="80"
APP_USER="www-data"
APP_GROUP="www-data"

# Database Configuration (read by scripts; never hardcode passwords in scripts)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="linkod_db"
DB_USER="linkod_user"
DB_PASS="Linkod_S3cur3_2026!"

# Backup & Runtime Directories
BACKUP_DIR="/var/backups/linkod"
LOG_DIR="/var/log/linkod"
LOCK_FILE="/run/linkod.lock"
